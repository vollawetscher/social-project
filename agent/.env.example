# Local development only. LiveKit Cloud injects these automatically for hosted agents.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_api_key
# LIVEKIT_API_SECRET=your_api_secret

# Supabase (load per-owner wake word + enabled flag)
SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional LiveKit Inference voice override
CARTESIA_VOICE_ID=...

# Web search + research (Perplexity Sonar)
PERPLEXITY_API_KEY=pplx-...
# Optional overrides:
# PERPLEXITY_MODEL=sonar
# PERPLEXITY_RESEARCH_MODEL=sonar
# PERPLEXITY_TIMEOUT_S=45

# URL scraping for read_url (Firecrawl)
FIRECRAWL_API_KEY=fc-...
# Optional overrides:
# FIRECRAWL_API_BASE=https://api.firecrawl.dev
# FIRECRAWL_TIMEOUT_S=20

# Optional pepper for inbound PIN hashing. If set, it MUST match the web app's
# VOICE_AGENT_PIN_PEPPER, or PIN verification will fail. Leave unset on both.
# VOICE_AGENT_PIN_PEPPER=

# Opt-in: feed the owner's known names (contacts + display name) to Deepgram as
# keyterms so proper nouns transcribe correctly. Off by default — enable only
# after verifying LiveKit inference forwards Deepgram `keyterm` in your setup.
# VOICE_AGENT_STT_KEYTERMS=0

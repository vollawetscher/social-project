# LiveKit Cloud credentials (same as the Next.js app)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# STT/LLM/TTS provider keys
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=...
CARTESIA_API_KEY=...

# Supabase (load per-owner wake word + enabled flag)
SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# German female voice ID from Cartesia (get from https://play.cartesia.ai/voices)
# Recommended: search for "Alina" or "Sabine" (German female voices), copy the voice ID
CARTESIA_VOICE_ID=...

# Recommended: search for "Alina" or "Sabine" (German female voices), copy the voice ID
CARTESIA_VOICE_ID=...

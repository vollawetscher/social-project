    "buildCommand": "echo 'cron service — no build step required'"
  },
  "deploy": {
    "startCommand": "sh scripts/trigger-reminders.sh",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
